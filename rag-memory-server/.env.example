# RAG Server Configuration

# 服务端口与地址
HOST=0.0.0.0
PORT=8765

# 本地 BM25 记忆库持久化文件（无需外部向量数据库/Embedding API）
MEMORY_STORE_PATH=./data/memory_store.json
COLLECTION_NAME=ex_memory_longteng

# 上游 LLM 对话配置（用于 /api/chat/complete 一站式代理 + 记忆精排）
# 示例：本地反重力代理 http://127.0.0.1:8045/v1，模型 gemini-3.6-flash-high
LLM_API_BASE=http://127.0.0.1:8045/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-3.6-flash-high

# 记忆精排（LLM 从 BM25 候选里挑选最相关的记忆）
RERANK_ENABLED=true
RERANK_CANDIDATES=15
RERANK_FINAL_K=3

# 对话会话切分配置
SESSION_SPLIT_MINUTES=30
MAX_MESSAGES_PER_CHUNK=15
MIN_MESSAGES_PER_CHUNK=2